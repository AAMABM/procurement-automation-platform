# Application
APP_NAME="Procurement Automation Platform"
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Security — MUST be overridden in production (>=32 chars, from secret manager)
SECRET_KEY=CHANGE_ME_use_a_long_random_string_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
POSTGRES_USER=procurement
POSTGRES_PASSWORD=procurement_dev_pw
POSTGRES_DB=procurement
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Bootstrap admin (Phase 1 only — disable in production, use IAM provisioning)
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=ChangeMe123!

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console           # console | json